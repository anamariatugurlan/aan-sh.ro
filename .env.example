# Mentenanta: pune 1 ca vizitatorii sa vada pagina "revenim in curand".
# Sterge sau pune 0 cand deschizi magazinul.
MENTENANTA=1

# Cheia cu care tu si clienta intrati sa vedeti site-ul in timpul mentenantei.
# Se foloseste o singura data: https://aan-sh.ro/?cheie=VALOAREA_DE_MAI_JOS
CHEIE_ACCES=schimba-aceasta-cheie

# ---- Conturile de administrare (/admin) ----
# Fiecare om are doua linii, numerotate: 1, 2, 3... (pana la 5 conturi).
# Se fac cu:  node scripts/parola.mjs email@exemplu.ro 1
# Parola in sine nu se scrie NICIODATA aici - doar amprenta ei.
# Amprenta are DOUA PUNCTE ca despartitor (scrypt:16384:...), nu semnul dolar:
# in fisierele de setari dolarul inseamna altceva si ar taia valoarea.
ADMIN_1_EMAIL=anamariatugurlan1@gmail.com
ADMIN_1_PAROLA_HASH=pune-aici-amprenta-data-de-script
ADMIN_2_EMAIL=little.demo.uk@gmail.com
ADMIN_2_PAROLA_HASH=pune-aici-amprenta-data-de-script
ADMIN_3_EMAIL=gabipopecu76@gmail.com
ADMIN_3_PAROLA_HASH=pune-aici-amprenta-data-de-script

# Cheia cu care se semneaza sesiunile de admin (o da tot scriptul de mai sus).
# Daca o schimbi, toti cei conectati acum trebuie sa intre din nou.
SESIUNE_SECRET=pune-aici-cheia-data-de-script
